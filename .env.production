# Production Environment Variables
NODE_ENV=production

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://peak.wisdombusara.com

# Database
DATABASE_URL=postgres://highpeak_user:YOUR_SECURE_PASSWORD@localhost:5432/highpeak

# Payload CMS
PAYLOAD_SECRET=YOUR_VERY_SECURE_SECRET_KEY_MIN_32_CHARS

# Optional: OpenAI (for chatbot LLM)
# OPENAI_API_KEY=sk-...

# Optional: Cloudflare R2 (for media)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# NEXT_PUBLIC_R2_URL=

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Email
# RESEND_API_KEY=
